PORT=4000
NODE_ENV=development

# Base URL of the frontend, used as the Paystack callback base
CLIENT_URL=http://localhost:4000

# Database: either a full connection string...
# DATABASE_URL=postgresql://user:password@host:5432/schoolpay
# ...or individual settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=schoolpay
DB_USER=postgres
DB_PASSWORD=

# At least 32 random characters
JWT_SECRET=

# First platform admin, created on startup if none exists
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudinary (bank document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fallback SMTP for receipts when a school has none configured
SMTP_USER=
SMTP_PASS=
